    "configuration": {
      "title": "NoteRoot",
      "properties": {
        "noteRoot.rootPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Absolute path of the folder where your notes are stored. Use **NoteRoot: Select Notes Folder** to choose it."
        },
        "noteRoot.defaultExtension": {
          "type": "string",
          "default": ".md",
          "pattern": "^\\.[A-Za-z0-9_-]+$",
          "scope": "window",
          "markdownDescription": "Extension added to new files when the name has no extension (must start with a dot). This is the default for all notes folders: a value saved with a notes folder (`custom.folderSettings` in its `.noteroot/config.json`, set from the Settings panel) wins."
        },
        "noteRoot.quickNoteFile": {
          "type": "string",
          "default": "quick-notes.md",
          "scope": "window",
          "markdownDescription": "File (relative to the notes folder) where Quick Notes are appended. Use **NoteRoot: Change Quick Note File** or the button in the title bar of the Quick Note panel to pick it. This is the default for all notes folders: a value saved with a notes folder (`custom.folderSettings` in its `.noteroot/config.json`, set from the Settings panel) wins."
        },
        "noteRoot.quickNoteTimestampFormat": {
          "type": "string",
          "default": "YYYY-MM-DD HH:mm",
          "scope": "window",
          "markdownDescription": "Format of the heading added above each Quick Note. Tokens: `YYYY`, `MM`, `DD`, `HH`, `mm`, `ss`. Leave empty for no timestamp. This is the default for all notes folders: a value saved with a notes folder (`custom.folderSettings` in its `.noteroot/config.json`, set from the Settings panel) wins."
        },
        "noteRoot.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".DS_Store",
            "Thumbs.db",
            ".git",
            ".noteroot",
            ".claude",
            ".vscode"
          ],
          "scope": "window",
          "markdownDescription": "Glob patterns of files and folders hidden from the NoteRoot tree. This is the default for all notes folders: a value saved with a notes folder (`custom.folderSettings` in its `.noteroot/config.json`, set from the Settings panel) wins."
        },
        "noteRoot.largeFileThresholdMB": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "scope": "window",
          "markdownDescription": "Ask for confirmation before opening files larger than this size (in MB). Use `0` to disable."
        },
        "noteRoot.sortOrder": {
          "type": "string",
          "enum": [
            "name",
            "modified"
          ],
          "enumDescriptions": [
            "Alphabetical, numbers in natural order.",
            "Newest first, by the date a file or folder was last modified."
          ],
          "default": "name",
          "scope": "window",
          "markdownDescription": "How the notes tree orders the items inside a folder. Folders always come first. Use **NoteRoot: Sort Notes By…** or the `...` menu of the Notes view to change it. This is the default for all notes folders: a value saved with a notes folder (`custom.folderSettings` in its `.noteroot/config.json`, set from the Settings panel) wins."
        },
        "noteRoot.quickNotePosition": {
          "type": "string",
          "enum": [
            "end",
            "start"
          ],
          "enumDescriptions": [
            "Each new Quick Note is added at the end of the file.",
            "Each new Quick Note goes at the start of the file, above the older ones (after a front matter block, if there is one)."
          ],
          "default": "end",
          "scope": "window",
          "markdownDescription": "Where a new Quick Note goes in its file. Use **NoteRoot: Quick Note Options…** or the `...` menu of the Quick Note panel to change it. This is the default for all notes folders: a value saved with a notes folder (`custom.folderSettings` in its `.noteroot/config.json`, set from the Settings panel) wins."
        },
        "noteRoot.quickNoteHeadingLevel": {
          "type": "string",
          "enum": [
            "#",
            "##",
            "###",
            "####",
            "plain"
          ],
          "enumDescriptions": [
            "A heading of level 1.",
            "A heading of level 2.",
            "A heading of level 3.",
            "A heading of level 4.",
            "Only the date and time on its own line, without a Markdown heading."
          ],
          "default": "##",
          "scope": "window",
          "markdownDescription": "How the date and time above each Quick Note is written. It has no effect when `noteRoot.quickNoteTimestampFormat` is empty. This is the default for all notes folders: a value saved with a notes folder (`custom.folderSettings` in its `.noteroot/config.json`, set from the Settings panel) wins."
        },
        "noteRoot.quickNoteTagLine": {
          "type": "string",
          "default": "**Tags:** {tags}",
          "scope": "window",
          "markdownDescription": "The line that carries the tags of a Quick Note (written between the heading and the text; a note without tags gets it empty when the template has text of its own). `{tags}` is replaced by the tags, for example `#ab-12312 #ab-222`. Examples: `{tags}` (only the tags), `Tags: {tags}`, `**Tags:** {tags}`, `#### Tags: {tags}`. It must be one line with `{tags}` in it. Use **NoteRoot: Quick Note Options…** to pick one. This is the default for all notes folders: a value saved with a notes folder (`custom.folderSettings` in its `.noteroot/config.json`, set from the Settings panel) wins."
        },
        "noteRoot.tagOnSave": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "When you save a note of the notes folder in the editor (Ctrl+S, not the automatic save), run the tagging on the notes you changed: the tags it gets by itself (keywords and tag patterns) are written in its tag line. In a file of Quick Notes only the entries you changed are tagged. Off by default. See **NoteRoot: Run Tagging on This Note**. This is the default for all notes folders: a value saved with a notes folder (`custom.folderSettings` in its `.noteroot/config.json`, set from the Settings panel) wins."
        }
      }
    },
    "keybindings": [
      {
        "command": "noteRoot.rename",
        "key": "f2",
        "when": "focusedView == noteRoot.tree"
      },
      {
        "command": "noteRoot.delete",
