        "title": "Encrypt…"
      },
      {
        "command": "noteRoot.decryptView",
        "title": "Decrypt for Viewing…"
      },
      {
        "command": "noteRoot.decryptNote",
        "title": "Decrypt Permanently…"
      },
      {
        "command": "noteRoot.tagNote",
        "title": "Run Tagging"
      },
      {
        "command": "noteRoot.tagCurrentNote",
        "title": "NoteRoot: Run Tagging on This Note"
      },
      {
        "command": "noteRoot.insertHeader",
        "title": "Insert Header"
      },
      {
        "command": "noteRoot.insertHeaderCurrentNote",
        "title": "Header",
        "category": "NoteRoot: Add"
      },
      {
        "command": "noteRoot.addDateAndTags",
        "title": "Date and Tags",
        "category": "NoteRoot: Add"
      },
      {
        "command": "noteRoot.moveTo",
        "title": "Choose Note…",
        "category": "NoteRoot: Move to"
      },
      {
        "command": "noteRoot.moveToQuickNote",
        "title": "Quick Note",
        "category": "NoteRoot: Move to"
      },
      {
        "command": "noteRoot.pinNote",
        "title": "Pin Note"
      },
      {
        "command": "noteRoot.unpinNote",
        "title": "Unpin Note"
      },
      {
        "command": "noteRoot.quickNoteOptions",
        "title": "NoteRoot: Quick Note Options…"
      },
      {
        "command": "noteRoot.changeQuickNoteFile",
        "title": "NoteRoot: Change Quick Note File",
        "icon": "$(file-symlink-file)"
      },
      {
        "command": "noteRoot.pasteAndSave",
        "title": "NoteRoot: Paste and Save to Quick Note"
      },
      {
        "command": "noteRoot.enableAdvanced",
        "title": "NoteRoot: Show Advanced Quick Note Options",
        "icon": "$(settings)"
      },
      {
        "command": "noteRoot.disableAdvanced",
        "title": "NoteRoot: Hide Advanced Quick Note Options",
        "icon": "$(settings)"
      },
      {
        "command": "noteRoot.changeCategoryFile",
        "title": "NoteRoot: Change Category File"
      },
      {
        "command": "noteRoot.manageLabels",
        "title": "NoteRoot: Manage Categories and Tags",
        "icon": "$(tag)"
      },
      {
        "command": "noteRoot.enableAutoCategories",
        "title": "NoteRoot: Auto Create Category for Every File (turn on)",
        "icon": "$(settings)"
      },
      {
        "command": "noteRoot.disableAutoCategories",
        "title": "NoteRoot: Auto Create Category for Every File (turn off)",
        "icon": "$(settings)"
      },
