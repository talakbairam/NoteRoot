        "when": "focusedView == noteRoot.tree"
      },
      {
        "command": "noteRoot.delete",
        "key": "cmd+backspace",
        "mac": "cmd+backspace",
        "when": "focusedView == noteRoot.tree && isMac"
      },
      {
        "command": "noteRoot.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "focusedView == noteRoot.tree"
      }
    ],
    "walkthroughs": [
      {
        "id": "noteRoot.gettingStarted",
        "title": "Get Started with NoteRoot",
        "description": "Set up your notes folder and write your first note.",
        "steps": [
          {
            "id": "chooseFolder",
            "title": "Choose your notes folder",
            "description": "Pick the folder where all your notes will live.\n[Select Notes Folder](command:noteRoot.selectRootFolder)",
            "completionEvents": [
              "onSettingChanged:noteRoot.rootPath"
            ],
            "media": {
              "markdown": "media/walkthrough/choose-folder.md"
            }
          },
          {
            "id": "createNote",
            "title": "Create your first note",
            "description": "Create a note in your folder.\n[New File](command:noteRoot.newFile)",
            "completionEvents": [
              "onCommand:noteRoot.newFile"
            ],
            "media": {
              "markdown": "media/walkthrough/create-note.md"
            }
          },
          {
            "id": "quickNote",
            "title": "Try Quick Note",
            "description": "Jot something down fast from the sidebar.\n[Focus Quick Note](command:noteRoot.focusQuickNote)",
            "completionEvents": [
              "onCommand:noteRoot.focusQuickNote"
            ],
            "media": {
              "markdown": "media/walkthrough/quick-note.md"
            }
          },
          {
            "id": "tags",
            "title": "Sort notes with categories and tags",
            "description": "Switch on the Advanced mode to send a Quick Note to another file and to add tags.\n[Turn On Advanced Options](command:noteRoot.enableAdvanced)",
            "completionEvents": [
              "onCommand:noteRoot.enableAdvanced"
            ],
            "media": {
              "markdown": "media/walkthrough/tags.md"
            }
          },
          {
            "id": "sync",
            "title": "Keep your notes in sync",
            "description": "Push your notes to GitHub and pull them on another computer.\n[Connect to a Sync Service](command:noteRoot.syncConnect)",
            "completionEvents": [
              "onCommand:noteRoot.syncConnect"
            ],
            "media": {
              "markdown": "media/walkthrough/sync.md"
            }
          }
        ]
      }
    ],
    "submenus": [
      {
        "id": "noteRoot.moveToMenu",
        "label": "Move to"
