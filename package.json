    "menus": {
      "view/title": [
        {
          "command": "noteRoot.search",
          "when": "view == noteRoot.tree && noteRoot.state == ready",
          "group": "navigation@0"
        },
        {
          "command": "noteRoot.newFile",
          "when": "view == noteRoot.tree && noteRoot.state != noRoot && noteRoot.state != missing",
          "group": "navigation@1"
        },
        {
          "command": "noteRoot.newFolder",
          "when": "view == noteRoot.tree && noteRoot.state != noRoot && noteRoot.state != missing",
          "group": "navigation@2"
        },
        {
          "command": "noteRoot.refresh",
          "when": "view == noteRoot.tree",
          "group": "navigation@3"
        },
        {
          "command": "noteRoot.expandAll",
          "when": "view == noteRoot.tree && noteRoot.state == ready",
          "group": "navigation@4"
        },
        {
          "command": "noteRoot.collapseAll",
          "when": "view == noteRoot.tree && noteRoot.state == ready",
          "group": "navigation@5"
        },
        {
          "command": "noteRoot.clearRecent",
          "when": "view == noteRoot.recent",
          "group": "navigation@1"
        },
        {
          "command": "noteRoot.changeQuickNoteFile",
          "when": "view == noteRoot.quickNote",
          "group": "navigation@1"
        },
        {
          "command": "noteRoot.enableAdvanced",
          "when": "view == noteRoot.quickNote && !noteRoot.advanced",
          "group": "navigation@2"
        },
        {
          "command": "noteRoot.disableAdvanced",
          "when": "view == noteRoot.quickNote && noteRoot.advanced",
          "group": "navigation@2"
        },
        {
          "command": "noteRoot.manageLabels",
          "when": "view == noteRoot.quickNote && noteRoot.advanced",
          "group": "9_options@2"
        },
        {
          "command": "noteRoot.showHiddenItems",
          "when": "view == noteRoot.tree && noteRoot.state == ready && !noteRoot.showHidden",
          "group": "1_view@1"
        },
        {
          "command": "noteRoot.hideHiddenItems",
          "when": "view == noteRoot.tree && noteRoot.state == ready && noteRoot.showHidden",
          "group": "1_view@1"
        },
        {
          "command": "noteRoot.changeRootFolder",
          "when": "view == noteRoot.tree",
          "group": "2_folder@1"
        },
        {
          "command": "noteRoot.openConfigFile",
          "when": "view == noteRoot.settings && noteRoot.hasRoot",
          "group": "2_files@1"
        },
        {
          "command": "noteRoot.revealRootInOS",
          "when": "view == noteRoot.tree && noteRoot.hasRoot",
          "group": "2_folder@2"
        },
        {
          "command": "noteRoot.openRootInNewWindow",
          "when": "view == noteRoot.tree && noteRoot.hasRoot",
          "group": "2_folder@3"
        },
        {
          "command": "noteRoot.showLogs",
          "when": "view == noteRoot.settings",
          "group": "2_files@2"
        },
        {
          "command": "noteRoot.sortBy",
          "when": "view == noteRoot.settings && noteRoot.state == ready",
          "group": "1_notes@1"
        },
        {
          "command": "noteRoot.undo",
          "when": "view == noteRoot.tree && noteRoot.state == ready",
          "group": "1_edit@1"
        },
        {
          "command": "noteRoot.quickNoteOptions",
          "when": "view == noteRoot.quickNote",
          "group": "9_options@1"
        },
        {
          "command": "noteRoot.refreshLabels",
          "when": "view == noteRoot.labels && noteRoot.hasRoot",
          "group": "navigation@2"
        },
        {
          "command": "noteRoot.enableAutoCategories",
          "when": "view == noteRoot.labels && noteRoot.hasRoot && !noteRoot.autoCategories",
          "group": "navigation@0"
        },
        {
          "command": "noteRoot.disableAutoCategories",
          "when": "view == noteRoot.labels && noteRoot.hasRoot && noteRoot.autoCategories",
          "group": "navigation@0"
        },
        {
          "command": "noteRoot.enableAutoTagPatterns",
          "when": "view == noteRoot.labels && noteRoot.hasRoot && !noteRoot.autoTagPatterns",
          "group": "navigation@1"
        },
        {
          "command": "noteRoot.disableAutoTagPatterns",
          "when": "view == noteRoot.labels && noteRoot.hasRoot && noteRoot.autoTagPatterns",
          "group": "navigation@1"
        },
        {
          "command": "noteRoot.openAllSettings",
          "when": "view == noteRoot.settings",
          "group": "navigation@0"
        },
        {
          "command": "noteRoot.syncRefresh",
          "when": "view == noteRoot.sync && noteRoot.syncConnected",
          "group": "navigation@0"
        },
        {
          "command": "noteRoot.syncPull",
          "when": "view == noteRoot.sync && noteRoot.syncConnected",
          "group": "navigation@1"
        },
        {
          "command": "noteRoot.syncPush",
          "when": "view == noteRoot.sync && noteRoot.syncConnected",
          "group": "navigation@2"
        },
        {
          "command": "noteRoot.syncChangeRepository",
          "when": "view == noteRoot.sync && noteRoot.syncConnected",
          "group": "1_repository@1"
        },
        {
          "command": "noteRoot.syncDisconnect",
          "when": "view == noteRoot.sync && noteRoot.syncConnected",
          "group": "1_repository@2"
        },
        {
          "command": "noteRoot.syncHistory",
          "when": "view == noteRoot.sync && noteRoot.syncConnected",
          "group": "1_repository@3"
        },
        {
          "command": "noteRoot.syncHidden",
          "when": "view == noteRoot.sync && noteRoot.syncConnected",
          "group": "1_repository@4"
        },
        {
          "command": "noteRoot.syncEncryptRepository",
          "when": "view == noteRoot.sync && noteRoot.syncConnected && !noteRoot.syncEncrypted",
          "group": "3_encryption@1"
        },
        {
          "command": "noteRoot.syncChangeKey",
          "when": "view == noteRoot.sync && noteRoot.syncConnected && noteRoot.syncEncrypted",
          "group": "3_encryption@2"
        },
        {
          "command": "noteRoot.syncForgetKey",
          "when": "view == noteRoot.sync && noteRoot.syncConnected && noteRoot.syncEncrypted",
          "group": "3_encryption@3"
        },
        {
          "command": "noteRoot.enableSyncAutoCheck",
          "when": "view == noteRoot.sync && noteRoot.syncConnected && !noteRoot.syncAutoCheck",
          "group": "2_check@1"
        },
        {
          "command": "noteRoot.disableSyncAutoCheck",
          "when": "view == noteRoot.sync && noteRoot.syncConnected && noteRoot.syncAutoCheck",
          "group": "2_check@1"
        }
      ],
      "commandPalette": [
        {
          "command": "noteRoot.encryptNote",
          "when": "false"
        },
        {
          "command": "noteRoot.decryptView",
          "when": "false"
        },
        {
          "command": "noteRoot.decryptNote",
          "when": "false"
        },
        {
          "command": "noteRoot.recreateRootFolder",
          "when": "false"
        },
        {
          "command": "noteRoot.newFile",
          "when": "false"
        },
        {
          "command": "noteRoot.newFolder",
          "when": "false"
        },
        {
          "command": "noteRoot.refresh",
          "when": "false"
        },
        {
          "command": "noteRoot.collapseAll",
          "when": "false"
        },
        {
          "command": "noteRoot.rename",
          "when": "false"
        },
        {
          "command": "noteRoot.delete",
          "when": "false"
        },
        {
          "command": "noteRoot.revealInOS",
          "when": "false"
        },
        {
          "command": "noteRoot.copyPath",
          "when": "false"
        },
        {
          "command": "noteRoot.copyRelativePath",
          "when": "false"
        },
        {
          "command": "noteRoot.openToSide",
          "when": "false"
        },
        {
          "command": "noteRoot.openPreviewToSide",
          "when": "false"
        },
        {
          "command": "noteRoot.addSelectionToQuickNote",
          "when": "editorHasSelection"
        },
        {
          "command": "noteRoot.search",
          "when": "noteRoot.hasRoot"
        },
        {
          "command": "noteRoot.removeFromRecent",
          "when": "false"
        },
        {
          "command": "noteRoot.revealInTree",
          "when": "false"
        },
        {
          "command": "noteRoot.clearRecent",
          "when": "noteRoot.hasRoot"
        },
        {
          "command": "noteRoot.changeQuickNoteFile",
          "when": "noteRoot.hasRoot"
        },
        {
          "command": "noteRoot.pasteAndSave",
          "when": "noteRoot.hasRoot"
        },
        {
          "command": "noteRoot.enableAdvanced",
          "when": "!noteRoot.advanced"
        },
        {
          "command": "noteRoot.disableAdvanced",
          "when": "noteRoot.advanced"
        },
        {
          "command": "noteRoot.changeCategoryFile",
          "when": "noteRoot.hasRoot"
        },
        {
          "command": "noteRoot.manageLabels",
          "when": "noteRoot.hasRoot"
        },
        {
          "command": "noteRoot.expandAll",
          "when": "noteRoot.state == ready"
        },
        {
          "command": "noteRoot.pinNote",
          "when": "false"
        },
        {
          "command": "noteRoot.unpinNote",
          "when": "false"
        },
        {
          "command": "noteRoot.sortBy",
          "when": "noteRoot.state == ready"
        },
        {
          "command": "noteRoot.duplicate",
          "when": "false"
