        "command": "noteRoot.enableAutoTagPatterns",
        "title": "NoteRoot: Auto Create Tag from Pattern (turn on)",
        "icon": "$(regex)"
      },
      {
        "command": "noteRoot.disableAutoTagPatterns",
        "title": "NoteRoot: Auto Create Tag from Pattern (turn off)",
        "icon": "$(regex)"
      },
      {
        "command": "noteRoot.manageTagPatterns",
        "title": "NoteRoot: Tag Patterns…"
      },
      {
        "command": "noteRoot.addTagPattern",
        "title": "NoteRoot: Add Tag Pattern…",
        "icon": "$(add)"
      },
      {
        "command": "noteRoot.editTagPattern",
        "title": "Change Pattern…"
      },
      {
        "command": "noteRoot.deleteTagPattern",
        "title": "Delete Pattern…"
