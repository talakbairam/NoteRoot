      },
      {
        "command": "noteRoot.enableSyncAutoCheck",
        "title": "NoteRoot: Check Sync for New Changes Automatically (turn on)"
      },
      {
        "command": "noteRoot.disableSyncAutoCheck",
        "title": "NoteRoot: Check Sync for New Changes Automatically (turn off)"
      },
      {
