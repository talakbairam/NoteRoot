{
  "name": "noteroot",
  "displayName": "NoteRoot",
  "description": "Notes in a folder you choose: a notes tree, a Quick Note box, tags and categories, and optional encrypted sync to GitHub.",
  "version": "0.1.0",
  "publisher": "talakbairam",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/talakbairam/NoteRoot.git"
  },
  "bugs": {
    "url": "https://github.com/talakbairam/NoteRoot/issues"
  },
  "homepage": "https://github.com/talakbairam/NoteRoot#readme",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Notebooks",
    "Other"
  ],
  "keywords": [
    "notes",
    "note taking",
    "markdown",
    "quick note",
    "sync",
    "github sync",
    "encryption",
    "encrypted notes",
    "tags",
    "tagging",
    "journal",
    "second brain",
    "plain text",
    "sidebar",
    "explorer"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "The notes folder must be accessible to the extension."
    },
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "noteRoot",
          "title": "NoteRoot",
          "icon": "media/noteroot.svg"
        }
      ]
    },
    "views": {
      "noteRoot": [
        {
          "id": "noteRoot.quickNote",
          "name": "Quick Note",
          "type": "webview",
          "icon": "media/noteroot.svg"
        },
        {
          "id": "noteRoot.tree",
          "name": "Notes",
          "type": "tree",
          "icon": "media/noteroot.svg"
        },
        {
          "id": "noteRoot.labels",
          "name": "Tags & Categories",
          "type": "tree",
          "icon": "media/noteroot.svg"
        },
        {
          "id": "noteRoot.recent",
          "name": "Pinned & Recent",
          "type": "tree",
          "icon": "media/noteroot.svg"
        },
        {
          "id": "noteRoot.sync",
          "name": "Actions",
          "type": "tree",
          "icon": "media/noteroot.svg",
          "visibility": "collapsed"
        },
        {
          "id": "noteRoot.settings",
          "name": "Settings",
          "type": "tree",
          "icon": "media/noteroot.svg",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "noteRoot.tree",
        "contents": "No notes folder selected.\n[Select Notes Folder](command:noteRoot.selectRootFolder)",
        "when": "noteRoot.state == noRoot"
      },
      {
        "view": "noteRoot.tree",
        "contents": "The notes folder was not found. It may have been moved or deleted, or its drive may be disconnected.\n[Select Another Folder](command:noteRoot.selectRootFolder)\n[Create Folder Again](command:noteRoot.recreateRootFolder)",
        "when": "noteRoot.state == missing"
      },
      {
        "view": "noteRoot.tree",
        "contents": "This notes folder is empty.\n[New File](command:noteRoot.newFile)\n[New Folder](command:noteRoot.newFolder)",
        "when": "noteRoot.state == empty"
      },
      {
        "view": "noteRoot.recent",
        "contents": "Nothing here yet. Notes you open appear under Recent, and a note you pin stays under Pinned: right-click a note and choose Pin Note."
      },
      {
        "view": "noteRoot.labels",
        "contents": "Select a notes folder to use tags and categories.\n[Select Notes Folder](command:noteRoot.selectRootFolder)",
        "when": "!noteRoot.hasRoot"
      },
      {
        "view": "noteRoot.sync",
        "contents": "Select a notes folder to use Sync.\n[Select Notes Folder](command:noteRoot.selectRootFolder)",
        "when": "!noteRoot.hasRoot"
      },
      {
        "view": "noteRoot.sync",
        "contents": "Keep your notes in sync with an online service to back them up and to open them on another computer. GitHub is available now, with no git and no other app needed.\n[Connect to a Sync Service](command:noteRoot.syncConnect)\nNothing is sent until you press Push.",
        "when": "noteRoot.hasRoot && !noteRoot.syncConnected"
      }
    ],
    "commands": [
      {
        "command": "noteRoot.focus",
        "title": "NoteRoot: Open Sidebar"
      },
      {
        "command": "noteRoot.selectRootFolder",
        "title": "NoteRoot: Select Notes Folder"
      },
      {
        "command": "noteRoot.changeRootFolder",
        "title": "NoteRoot: Change Notes Folder"
      },
      {
        "command": "noteRoot.recreateRootFolder",
        "title": "NoteRoot: Create Notes Folder Again"
      },
      {
        "command": "noteRoot.revealRootInOS",
        "title": "NoteRoot: Reveal Root Folder in OS"
      },
      {
        "command": "noteRoot.openRootInNewWindow",
        "title": "NoteRoot: Open Notes Folder in New Window"
      },
      {
        "command": "noteRoot.openConfigFile",
        "title": "NoteRoot: Open Config File"
      },
      {
        "command": "noteRoot.showLogs",
        "title": "NoteRoot: Show Logs"
      },
      {
        "command": "noteRoot.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "noteRoot.sortBy",
        "title": "NoteRoot: Sort Notes By…"
      },
      {
        "command": "noteRoot.expandAll",
        "title": "Expand All",
        "icon": "$(expand-all)"
      },
      {
        "command": "noteRoot.collapseAll",
        "title": "Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "noteRoot.newFile",
        "title": "New File",
        "icon": "$(new-file)"
      },
      {
        "command": "noteRoot.newFolder",
        "title": "New Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "noteRoot.undo",
        "title": "NoteRoot: Undo Last Rename or Move"
      },
      {
        "command": "noteRoot.duplicate",
        "title": "Duplicate"
      },
      {
        "command": "noteRoot.excludeItem",
        "title": "Hide from NoteRoot"
      },
      {
        "command": "noteRoot.includeItem",
        "title": "Show in NoteRoot Again"
      },
      {
        "command": "noteRoot.excludeFromTagging",
        "title": "Don't Auto-Tag"
      },
      {
        "command": "noteRoot.includeInTagging",
        "title": "Auto-Tag Again"
      },
      {
        "command": "noteRoot.showHiddenItems",
        "title": "Show Hidden Items",
        "category": "NoteRoot"
      },
      {
        "command": "noteRoot.hideHiddenItems",
        "title": "Hide Hidden Items",
        "category": "NoteRoot"
      },
      {
        "command": "noteRoot.rename",
        "title": "Rename"
      },
      {
        "command": "noteRoot.delete",
        "title": "Delete"
      },
      {
        "command": "noteRoot.revealInOS",
        "title": "Reveal in OS"
      },
      {
        "command": "noteRoot.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "noteRoot.copyRelativePath",
        "title": "Copy Relative Path"
      },
      {
        "command": "noteRoot.openToSide",
        "title": "Open to the Side"
      },
      {
        "command": "noteRoot.openPreviewToSide",
        "title": "Open Preview to the Side"
      },
      {
        "command": "noteRoot.focusQuickNote",
        "title": "NoteRoot: Focus Quick Note"
      },
      {
        "command": "noteRoot.addSelectionToQuickNote",
        "title": "Add Selection to Quick Note",
        "category": "NoteRoot"
      },
      {
        "command": "noteRoot.search",
        "title": "NoteRoot: Search Notes",
        "icon": "$(search)"
      },
      {
        "command": "noteRoot.clearRecent",
        "title": "NoteRoot: Clear Recent Notes",
        "icon": "$(clear-all)"
      },
      {
        "command": "noteRoot.removeFromRecent",
        "title": "Remove from Recent"
      },
      {
        "command": "noteRoot.revealInTree",
        "title": "Reveal in Notes Tree"
      },
      {
        "command": "noteRoot.editSetting",
        "title": "Change Setting…"
      },
      {
        "command": "noteRoot.resetSetting",
        "title": "Reset to Default"
      },
      {
        "command": "noteRoot.showSettingInEditor",
        "title": "Show in Settings Editor"
      },
      {
        "command": "noteRoot.openAllSettings",
        "title": "NoteRoot: Open Settings Editor",
        "icon": "$(settings-gear)"
      },
      {
        "command": "noteRoot.syncConnect",
        "title": "NoteRoot: Connect to a Sync Service"
      },
      {
        "command": "noteRoot.syncChangeRepository",
        "title": "NoteRoot: Change Sync Target"
      },
      {
        "command": "noteRoot.syncDisconnect",
        "title": "NoteRoot: Disconnect from Sync"
      },
      {
        "command": "noteRoot.syncHistory",
        "title": "NoteRoot: Choose How Sync Keeps Commits"
      },
      {
        "command": "noteRoot.syncHidden",
        "title": "NoteRoot: Choose Whether Sync Includes Hidden Files"
      },
      {
        "command": "noteRoot.syncShowChange",
        "title": "NoteRoot: Show Change"
      },
      {
        "command": "noteRoot.syncForgetKey",
        "title": "NoteRoot: Forget the Saved Master Key"
      },
      {
        "command": "noteRoot.syncChangeKey",
        "title": "NoteRoot: Change the Master Key"
      },
      {
        "command": "noteRoot.syncEncryptRepository",
