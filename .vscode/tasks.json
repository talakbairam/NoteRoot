// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	// On Windows the tasks run in cmd: PowerShell may refuse to start npm.ps1 (running scripts is disabled by default).
	"windows": {
		"options": {
			"shell": {
				"executable": "cmd.exe",
				"args": ["/d", "/c"]
			}
		}
	},
	"tasks": [
		{
            "label": "watch",
            "dependsOn": [
                "npm: watch:tsc",
                "npm: watch:esbuild"
            ],
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "npm",
            "script": "watch:esbuild",
            "group": "build",
            // The same job as "$esbuild-watch" of the ES Build Problem Matchers extension, written here so F5 works without it.
            "problemMatcher": {
                "owner": "esbuild",
                "source": "esbuild",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": [
                    { "regexp": "^[✘▲] \\[(ERROR|WARNING)\\] (.*)$", "severity": 1, "message": 2 },
                    { "regexp": "^\\s+(.+):(\\d+):(\\d+):\\s*$", "file": 1, "line": 2, "column": 3 }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\[watch\\] build started",
                    "endsPattern": "^\\[watch\\] build finished"
                }
            },
            "isBackground": true,
            "label": "npm: watch:esbuild",
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        },
		{
            "type": "npm",
            "script": "watch:tsc",
            "group": "build",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "label": "npm: watch:tsc",
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        }
	]
}
